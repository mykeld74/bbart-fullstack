    "sanity": "^6.14.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "eslint": "^10.0.0",
    "lexorank": "^1.0.5",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0"
  },
  "prettier": {
    "semi": false,
